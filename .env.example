# ── Wallet ────────────────────────────────────────────────────────────────────
WALLET_PRIVATE_KEY=your_base58_private_key_here

# ── Solana RPC ─────────────────────────────────────────────────────────────────
RPC_URL=https://mainnet.helius-rpc.com/?api-key=your_helius_api_key_here

# ── LLM Provider ──────────────────────────────────────────────────────────────
# Option A: OpenRouter (default)
OPENROUTER_API_KEY=sk-or-your_openrouter_key_here

# Option B: LM Studio (local) — uncomment these and comment out OPENROUTER_API_KEY
# LLM_BASE_URL=http://localhost:1234/v1
# LLM_API_KEY=lm-studio
# LLM_MODEL=your-model-name-from-lmstudio

# ── API Keys ───────────────────────────────────────────────────────────────────
HELIUS_API_KEY=your_helius_api_key_here
# LPAGENT_API_KEY tidak wajib (relay LPAgent sudah nonaktif, pakai Meteora gratis)
LPAGENT_API_KEY=

# ── Telegram Mini App "Kantor LP" ──────────────────────────────────────────────
# Bot dibuat di @BotFather. Token dipakai HANYA untuk memverifikasi siapa yang membuka Mini App.
# (Tidak ada fitur chat/perintah/notifikasi bot — semua tampil di Mini App.)
TELEGRAM_BOT_TOKEN=
# WAJIB: ID Telegram kamu (angka, dari @userinfobot). Boleh lebih dari satu, pisahkan koma.
# Kalau kosong, Mini App menolak semua akses.
TELEGRAM_ALLOWED_USER_IDS=
# Alamat HTTPS publik (Cloudflare Named Tunnel), mis. https://kantor.domainmu.com
# Alamat yang sama ini kamu isi di BotFather (Menu Button). Harus HTTPS valid, bukan localhost/IP/http.
MINIAPP_URL=
# Server Mini App hanya buka di localhost; tunnel meneruskan ke port ini.
MINIAPP_PORT=8787
MINIAPP_HOST=127.0.0.1
# Hanya untuk uji lokal tanpa Telegram (melewati validasi). DIABAIKAN otomatis di PM2/production.
# MINIAPP_DEV=true

# ── Dangerous admin actions (disabled by default) ─────────────────────────────
ALLOW_SELF_UPDATE=false

# ── Misc ───────────────────────────────────────────────────────────────────────
DRY_RUN=true   # biarkan true dulu (simulasi, tidak pakai uang). Ganti false kalau sudah yakin
LOG_LEVEL=info
